# ---------- Remote API ----------
VITE_API_URL=https://api.example.com
VITE_API_PREFIX=/api
VITE_API_VERSION=

# ---------- Request encryption ----------
VITE_API_ENCRYPTION_ENABLED=false

# ---------- Local dev server ----------
# VITE_DEV_HOST=localhost
# VITE_DEV_PORT=3000
# VITE_DEV_HTTPS=true
# VITE_DEV_HTTPS_KEY=.cert/dev.key
# VITE_DEV_HTTPS_CERT=.cert/dev.crt

# ---------- Storage ----------
VITE_CACHE_PREFIX=app_
VITE_CACHE_AES_KEY=app_cache_aes
VITE_TOKEN_KEY=token
VITE_DEVICE_KEY=device

# ---------- Auth ----------
# Comma-separated exact paths or prefix paths ending with slash.
# VITE_API_NO_TOKEN_PATHS=/auth/login,/auth/register,/auth/
# VITE_PROTECTED_ROUTES=/mine,/account

# ---------- Build enhancements ----------
VITE_BUILD_VISUALIZER=false
VITE_BUILD_OBFUSCATE=false
